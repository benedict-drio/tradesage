# Claude API key — the OPERATOR's key, not something end users supply.
#
# In the CLI prototype you are both operator and user, so it sits here. In the
# hosted product it lives on the server: a user types a sentence in the browser,
# the backend calls Claude with this key, and the browser never sees it. Users
# need a Stacks wallet, never an AI account.
#
# Needed only by `chat` (compiling a plain-English strategy into a rule) and
# `tick --explain`. Everything else — init, status, market, tick, strategy add,
# proposals, approve, live-quote, live-execute — runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a funded Stacks key, only for `live-execute`. Never leaves this machine.
# STACKS_PRIVATE_KEY=
