{
  "name": "tradesage",
  "version": "0.1.0",
  "description": "TradeSage \u2014 non-custodial AI trading copilot for Stacks DEXs (paper-trading prototype)",
  "type": "module",
  "bin": {
    "tradesage": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "stacks",
    "bitcoin",
    "sbtc",
    "defi",
    "ai",
    "trading-bot",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@stacks/transactions": "^7.5.0",
    "@velarprotocol/velar-sdk": "^0.7.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
